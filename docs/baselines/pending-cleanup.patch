-}
-
-#[test]
-fn explicit_headless_state_persists_and_maintenance_prints_no_values() {
-    let component = counter_component();
-    let directory = tempdir().unwrap();
-    let root = path_str(directory.path());
-    let activated = youth([
-        "activate",
-        path_str(&component),
-        "--node",
-        "4",
-        "--app-id",
-        "dev.youth.counter",
-        "--state-dir",
