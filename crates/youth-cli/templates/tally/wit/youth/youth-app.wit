package youth:app@0.0.8;

interface ui {
    type node-id = u64;
    type tree-revision = u64;
    type event-sequence = u64;

    record grid-layout {
        columns: u8,
    }

    variant box-layout {
        column,
        row,
        grid(grid-layout),
    }

    enum text-alignment {
        start,
        center,
        end,
    }

    record schedule-ref {
        id: u64,
        generation: u64,
    }

    enum time-precision {
        seconds,
    }

    enum countdown-format {
        minutes-seconds,
    }

    record countdown-data {
        schedule: schedule-ref,
        precision: time-precision,
        format: countdown-format,
    }

    variant text-content {
        literal(string),
        countdown(countdown-data),
    }

    variant shortcut-key {
        character(string),
        enter,
        escape,
        backspace,
    }

    flags shortcut-modifiers {
        primary,
    }

    record shortcut {
        key: shortcut-key,
        modifiers: shortcut-modifiers,
    }

    record box-data {
        enabled: bool,
        layout: box-layout,
    }

    record text-data {
        content: text-content,
        alignment: text-alignment,
    }

    record inline-editor-data {
        document-revision: u64,
        text: string,
    }

    record document-handle {
        id: u64,
        generation: u64,
    }

    record document-version {
        id: u64,
        generation: u64,
    }

    record text-document-editor-data {
        document: document-handle,
        version: document-version,
    }

    variant editor-data {
        inline(inline-editor-data),
        text-document(text-document-editor-data),
    }

    record button-data {
        label: string,
        enabled: bool,
        shortcuts: list<shortcut>,
    }

    variant node-data {
        root,
        box(box-data),
        text(text-data),
        editor(editor-data),
        button(button-data),
    }

    record node {
        id: node-id,
        data: node-data,
        children: list<node-id>,
    }

    record tree-snapshot {
        revision: tree-revision,
        root: node-id,
        nodes: list<node>,
    }

    record create-node {
        value: node,
    }

    record delete-node {
        id: node-id,
    }

    record set-text {
        id: node-id,
        value: text-content,
    }

    record set-label {
        id: node-id,
        value: string,
    }

    record set-enabled {
        id: node-id,
        value: bool,
    }

    record set-editor-document-version {
        id: node-id,
        document: document-handle,
        version: document-version,
    }

    record insert-child {
        parent: node-id,
        index: u32,
        child: node-id,
    }

    record remove-child {
        parent: node-id,
        index: u32,
        expected-child: node-id,
    }

    record move-child {
        parent: node-id,
        from-index: u32,
        to-index: u32,
        expected-child: node-id,
    }

    variant patch {
        create(create-node),
        delete(delete-node),
        set-text(set-text),
        set-label(set-label),
        set-enabled(set-enabled),
        set-editor-document-version(set-editor-document-version),
        insert-child(insert-child),
        remove-child(remove-child),
        move-child(move-child),
    }

    record elapsed-schedule {
        id: u64,
        generation: u64,
        reason: elapsed-reason,
    }

    record editor-dirty-change {
        editor: node-id,
        dirty: bool,
    }

    record save-request {
        id: u64,
        generation: u64,
    }

    record saved-document {
        document: document-handle,
        version: document-version,
        saved-edit-sequence: u64,
        still-dirty: bool,
    }

    enum text-document-error-code {
        conflict,
        missing,
        wrong-type,
        permission-denied,
        unavailable,
        internal,
    }

    variant save-outcome {
        saved(saved-document),
        failed(text-document-error-code),
    }

    record save-completion {
        request: save-request,
        outcome: save-outcome,
    }

    enum elapsed-reason {
        deadline,
        recovered-overdue,
    }

    variant event-kind {
        activate(node-id),
        schedule-elapsed(elapsed-schedule),
        editor-dirty-changed(editor-dirty-change),
        text-document-save-completed(save-completion),
    }

    record event {
        sequence: event-sequence,
        kind: event-kind,
    }

    record event-batch {
        tree-revision: tree-revision,
        events: list<event>,
    }

    record patch-batch {
        base-tree-revision: tree-revision,
        next-tree-revision: tree-revision,
        processed-through: event-sequence,
        patches: list<patch>,
    }

    enum app-error-code {
        invalid-state,
        rejected-event,
        internal,
    }

    record app-error {
        code: app-error-code,
        message: option<string>,
    }
}

interface lifecycle {
    use ui.{
        tree-snapshot,
        event-batch,
        patch-batch,
        app-error,
    };

    mount: func() -> result<tree-snapshot, app-error>;
    handle: func(events: event-batch) -> result<patch-batch, app-error>;
    resync: func() -> result<tree-snapshot, app-error>;
}

world application {
    import youth:editor/session@0.0.1;
    import youth:state/store@0.0.1;
    import youth:text-document/document@0.0.1;
    import youth:time/scheduler@0.0.1;
    export lifecycle;
}
