package youth:state@0.0.1;

interface store {
    variant value {
        boolean(bool),
        integer(s64),
        text(string),
        bytes(list<u8>),
    }

    enum error-code {
        unavailable,
        invalid-key,
        invalid-value,
        read-only,
        quota-exceeded,
        busy,
        internal,
    }

    record state-error { code: error-code, message: option<string> }
    get: func(key: string) -> result<option<value>, state-error>;
    set: func(key: string, value: value) -> result<_, state-error>;
    delete: func(key: string) -> result<bool, state-error>;
}

