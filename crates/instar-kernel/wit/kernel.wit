package instar:kernel@0.1.0;

// The Instar kernel world (WP4). Unlike `world.wit`'s `kernel-spike`, this one
// is meant to survive: it encodes the guest lifecycle rules Gate 0 forced.
//
// The central rule (docs/PHASE-1.md, "Guest lifetime boundary"): a guest's
// lifetime boundary is its Store plus component instance. Cancelling a guest
// means destroying its whole generation. That is why cancellation appears
// twice in this file at two very different scales, and why only one of them is
// visible to the guest:
//
//   - Per-operation cancellation IS in this world (`ops.cancel`). The guest
//     asks the host to cancel one operation; the host cancels it; the guest
//     task stays alive and keeps running.
//   - Whole-generation teardown is NOT in this world, and deliberately so.
//     It is a host-side decision executed by dropping the instance and Store,
//     and a guest cannot request or observe it -- from the guest's point of
//     view its generation simply ceases to exist.

interface kernel-types {
    /// Failure returned by `kernel-runtime.next-event`.
    variant runtime-error {
        /// No more events; leave the event loop and return from `run`.
        shutdown,
        /// The host could not produce an event.
        internal(string),
    }

    /// Failure returned by `kernel-ui.commit`.
    variant commit-error {
        /// The batch failed to decode or validate.
        invalid-batch(string),
        /// The committing generation is no longer current, so the host
        /// discarded the batch. A guest should not normally see this: by the
        /// time a generation is superseded its instance is being dropped. It
        /// exists so that a stale commit is *rejected explicitly* rather than
        /// silently applied to a successor generation's state.
        stale-generation,
    }

    record commit-result {
        revision: u64,
    }

    /// Failure returned by `ops.await-op`.
    variant op-error {
        /// The operation was cancelled before it completed -- either because
        /// the guest asked (`ops.cancel`), or because the host cancelled it
        /// while tearing down the operation's generation.
        cancelled,
        /// The operation ran and failed.
        failed(string),
        /// No such operation in this generation. Also what a guest gets if it
        /// names an operation belonging to a previous generation.
        unknown,
    }
}

/// Host-provided event delivery. Suspending here must cost nothing (see
/// docs/PHASE-1.md WP3's hard idle gates, proven by Gate 0).
interface kernel-runtime {
    use kernel-types.{runtime-error};

    next-event: async func() -> result<list<u8>, runtime-error>;
}

/// Host-provided UI commit. Synchronous on purpose: bounded, in-memory work
/// does not need the async machinery.
interface kernel-ui {
    use kernel-types.{commit-result, commit-error};

    commit: func(batch: list<u8>) -> result<commit-result, commit-error>;
}

/// Host-owned long-running operations.
///
/// Operations are owned by the host and by exactly one generation. Starting
/// one is synchronous and cheap (it hands back an id); awaiting it is where
/// the guest task suspends; cancelling it is a normal, expected part of guest
/// control flow rather than an error path.
interface ops {
    use kernel-types.{op-error};

    /// Starts an operation and returns its id immediately, without suspending.
    ///
    /// Splitting `start` from `await-op` is what makes cancellation
    /// expressible at all: the guest holds an id it can act on while the
    /// operation is still in flight.
    start: func(kind: string, payload: list<u8>) -> u64;

    /// Suspends until the operation completes, fails, or is cancelled.
    await-op: async func(id: u64) -> result<list<u8>, op-error>;

    /// Asks the host to cancel an in-flight operation.
    ///
    /// Returns whether an operation was actually cancelled (false if it had
    /// already finished, or was never known). A pending `await-op` for this id
    /// resolves with `op-error.cancelled`. **The calling guest task stays
    /// alive** -- this is the per-operation cancellation path, and it must
    /// never be confused with tearing down a generation.
    cancel: func(id: u64) -> bool;
}

world kernel {
    import kernel-runtime;
    import kernel-ui;
    import ops;

    /// The guest's entire program: run until the host says shutdown.
    export run: async func() -> result<_, string>;
}
