---
/**
 * Docs masthead title. Keeps the portal wordmark in the documentation header so
 * the two halves of the site read as one publication.
 */
---

<a class="docs-wordmark" href="/">
  INSTAR<span class="spark" aria-hidden="true">✦</span>
  <span class="docs-wordmark-tag">GUIDE</span>
</a>

<style>
  .docs-wordmark {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--sl-color-white);
    font: 900 21px/1 Arial, Helvetica, sans-serif;
    letter-spacing: -1.4px;
    text-decoration: none;
    white-space: nowrap;
  }

  .docs-wordmark .spark {
    margin-left: -3px;
    color: #ff5a00;
    font-size: 15px;
    vertical-align: 2px;
    letter-spacing: 0;
  }

  .docs-wordmark-tag {
    padding: 2px 5px;
    background: #ff5a00;
    color: #fff;
    font: bold 8px/1 Verdana, Geneva, sans-serif;
    letter-spacing: 0.08em;
  }

  @media (max-width: 50rem) {
    .docs-wordmark-tag {
      display: none;
    }
  }
</style>
